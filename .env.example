# Copy to .env for local use (node --env-file=.env src/server.js), or set these
# as Variables on your Railway service.

# --- Required in production -------------------------------------------------
# PIN for the manager dashboard (/manager). If empty, the dashboard is open.
MANAGER_PIN=
# Long random string. Signs logins and the one-tap ticket links in alerts.
# Keep it stable or old links stop working. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Site PIN each worker device (Zebra scanner, phone) enters once. Strongly
# recommended on Railway, where the app is on the public internet. Empty = none.
WORKER_PIN=

# --- Usually automatic on Railway --------------------------------------------
# Public base URL for ticket links in alerts and QR labels.
# Railway: defaults to https://$RAILWAY_PUBLIC_DOMAIN. Set it if you use a custom domain.
PUBLIC_URL=
# Where the SQLite database and photos are stored.
# Railway: defaults to the attached Volume's mount path (RAILWAY_VOLUME_MOUNT_PATH).
DATA_DIR=
# Trust X-Forwarded-* from a reverse proxy. Railway: defaults to 1.
TRUST_PROXY=
PORT=3000

# --- Email (pick one) --------------------------------------------------------
# Resend works on every Railway plan (HTTPS API). Railway blocks SMTP below Pro.
RESEND_API_KEY=
# Must be an address on a domain you verified with your email provider.
EMAIL_FROM=Forklift Alerts <alerts@yourcompany.com>
# SMTP (Railway Pro plan or other hosts only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Text messages (Twilio) ---------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number in E.164 format, e.g. +15551234567
TWILIO_FROM=

# --- Other ---------------------------------------------------------------------
# Create sample lifts (R-01…, L-01…, D-01…) on first start. Set to false for a clean fleet.
SEED_DEMO=true
# Timezone used for shift windows in alert rules and times in messages.
TZ=America/Chicago
